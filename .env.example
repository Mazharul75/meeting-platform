# Copy to .env and fill in real values. .env is git-ignored. NEVER commit real keys.
# All values below are FAKE.

APP_ENV=dev                      # dev | prod
APP_BASE_URL=http://localhost:8000
SECRET_KEY=change-me-64-random-bytes-generate-with-python-secrets
MASTER_KEY=change-me-another-64-random-bytes-back-this-up-offline

# Supabase Postgres via the pooler.
#   DATABASE_URL           = Transaction pooler string (used by the running app)
#   MIGRATION_DATABASE_URL = Session pooler string (used only by "alembic upgrade head")
# Paste them as-is; the app converts postgresql:// to postgresql+asyncpg:// itself.
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
MIGRATION_DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Supabase Storage (private bucket named "recordings").
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=fake-service-role-key
STORAGE_BUCKET=recordings

# Used from the online-meeting build onward (leave empty for now).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

SENTRY_DSN=

# Local development without Supabase: leave SUPABASE_* empty and use
#   DATABASE_URL=sqlite+aiosqlite:///./dev.db
# recordings are then stored in ./.dev_storage (dev only, refused in prod).

# Optional: show /dev/recorder-test even in prod (turn it off again afterwards).
ENABLE_DEV_TOOLS=false
